{
  "name": "jfood",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  },
  "scripts": {
    "build": "npm run build -w @jfood/core && npm run build -w @jfood/api",
    "build:core": "npm run build -w @jfood/core",
    "lint": "npm run lint --workspaces --if-present",
    "postinstall": "npm run build -w @jfood/core",
    "start:api": "npm run dev -w @jfood/api",
    "start:api:prod": "npm run build && npm run start -w @jfood/api",
    "catalog:build": "npm run catalog:build -w @jfood/mobile",
    "catalog:assemble": "npm run catalog:assemble -w @jfood/mobile",
    "release:export": "npm exec -w @jfood/mobile -- expo export --platform android",
    "release:doctor": "npm exec -w @jfood/mobile -- expo-doctor",
    "release:check": "npm test && npm run typecheck && npm run lint && npm run build && npm run release:export && npm run release:doctor",
    "release:set-api-url": "npm exec -w @jfood/mobile -- tsx scripts/setApiUrl.ts",
    "start:mobile": "npm run build -w @jfood/core && npm run start -w @jfood/mobile",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0"
  }
}
