# Backend only. Never expose these values through EXPO_PUBLIC_* variables.
# Copy to apps/api/.env for local development; on Render set them as env vars.

# Gemini key (https://aistudio.google.com/apikey). Without it the recognition
# routes answer 503 and the rest of the API keeps working.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

API_HOST=0.0.0.0
API_PORT=3000
# Render (and some hosts) inject PORT; it takes priority over API_PORT.
# PORT=

# Reverse proxies between the client and the API whose X-Forwarded-For is
# trusted (0-5). On Render it defaults to 1 when RENDER is set.
# TRUST_PROXY_HOPS=

# Shared secret the app sends in the x-app-token header. Leave empty to keep
# /recognize and /parse-meal open (local development). Use the same value as
# EXPO_PUBLIC_APP_TOKEN when building the experimental APK.
APP_TOKEN=

# Gemini calls per UTC day: shared by everyone, and per client IP.
RECOGNIZE_DAILY_LIMIT=300
RECOGNIZE_DAILY_LIMIT_PER_IP=40
